{
  "name": "sabretooth",
  "productName": "Sabretooth",
  "version": "0.1.4",
  "description": "Sabretooth (working title): single-player Ice Age Smilodon pride game. Main menu only.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "start:linux-dev": "electron . --no-sandbox",
    "screenshots": "electron . --no-sandbox --screenshots",
    "sync-copy": "node scripts/sync-copy.js && node scripts/sync-events.js && node scripts/slice-data-from-specs.js",
    "test": "node --test \"test/*.test.js\"",
    "appearance-preview": "electron scripts/appearance-preview.js --no-sandbox",
    "dist:win": "electron-builder --win nsis",
    "test:e2e": "node test/e2e/menu.e2e.js && node test/e2e/slice.e2e.js && node test/e2e/conversation.e2e.js"
  },
  "author": "Anna Kremer",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.64.1"
  },
  "build": {
    "appId": "com.annakremer.sabretooth",
    "productName": "Sabretooth",
    "files": [
      "src/**/*",
      "package.json",
      "assets/audio/menu/*.ogg",
      "assets/menu/background.{png,jpg,webp}",
      "assets/menu/background-1920.png",
      "assets/menu/logo.png",
      "assets/game/home-landscape.png",
      "assets/encounters/*.png",
      "assets/portraits/registry.json",
      "assets/portraits/*/manifest.json",
      "assets/portraits/*/*.png",
      "build/icon.png",
      "build/icon.ico",
      "!audio-src/**",
      "!assets/menu/night/**",
      "!**/work/**",
      "!**/rejected/**",
      "!**/compare/**",
      "!**/*.{py,psd,kra,xcf,npy}",
      "!scripts/**",
      "!assets/appearance/**",
      "!src/renderer/appearance-preview.html",
      "!src/renderer/js/appearance-render.js",
      "!src/renderer/js/appearance-preview.js",
      "!src/renderer/js/png-decode.js",
      "!docs/**",
      "!screenshots/**",
      "node_modules/electron-updater/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "delishyp",
        "repo": "sabretooth-game",
        "private": false
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
